__pycache__/
*.pyc
.env
.venv/
venv/
*.db
sim/data/*.json
!sim/data/.gitkeep
# The recorded L1 classifications are an INPUT, not an output. Arm D replays
# them, so without this file in the repo the measured LLM result cannot be
# reproduced by anyone else and the numbers in the README become unverifiable
# assertions. Generated batches and arm results stay ignored - those rebuild
# from a seed.
!sim/data/l1_classifications_seed42.json
# Same reasoning: a real captured Razorpay test-mode failure (sim/demo_live_trace.py)
# is an INPUT tied to a specific real payment, not something a seed regenerates.
!sim/data/live_failure_capture.json
node_modules/
dist/
.DS_Store

# scratch: files staged for manual deletion (device_bash cannot delete)
_to_delete/
